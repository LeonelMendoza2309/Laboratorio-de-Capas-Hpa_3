
using System;
using System.Collections.Generic;
using System.ComponentModel;
using System.Data;
using System.Drawing;
using System.Windows.Forms;
using Entidades;
using Negocio;
using Datos;

namespace Presentación
{
    public partial class frmLogin : Form
    {
        public frmLogin()
        {
            InitializeComponent();
        }

        private void btnIniciarSesion_Click(object sender, EventArgs e)
        {
            string strUsuario = txtUsuario.Text;
            string strPassword = txtContraseña.Text;
            E_Usuario usuario = N_Usuario.Login(strUsuario, strPassword);
            if (usuario != null && usuario.ID > 0)
            {
                // Login exitoso
                MessageBox.Show("¡Bienvenido, " + usuario.dsUsuario + "!", "Login Exitoso",
                    MessageBoxButtons.OK, MessageBoxIcon.Information);
                // Aquí puedes abrir el formulario principal de tu aplicación
                this.Hide(); // Oculta el formulario de login
                frmPrincipal principalForm = new frmPrincipal(); // Asegúrate de tener un formulario
                // principal
                principalForm.Show();
                // this.Close(); // Cierra el formulario de login después de cerrar el
                // principal
            }
            else
            {
                // Login fallido
                MessageBox.Show("Usuario o contraseña incorrectos.", "Error de Login",
                    MessageBoxButtons.OK, MessageBoxIcon.Error);
            }
        }
    }
}

